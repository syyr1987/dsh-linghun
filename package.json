{
  "name": "dsh-linghun",
  "version": "0.1.3",
  "description": "灵魂（Linghun）— 给 DeepSeek Harness 装一个会思考的自我。一张灵魂卡自定义四个字段：姓名、性格、沟通风格、其他——我是谁，由你亲手写；认知循环让判断有来处、反馈有归因、改进不断链；海马体把经历沉淀成知识与经验，踩过的坑下次不踩。不是人设卡，是判断力。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.1.0-rc.7 <0.2.0",
      "node": ">=20.18",
      "profiles": [
        "web"
      ]
    }
  },
  "files": [
    "index.js",
    "identity.js",
    "memory.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "homepage": "https://github.com/syyr1987/dsh-linghun",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "soul",
    "cognition",
    "memory",
    "hippocampus",
    "cognitive-agent"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/syyr1987/dsh-linghun.git"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-home-paths": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.7"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "author": "syyr1987"
}
